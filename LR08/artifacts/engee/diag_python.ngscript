  "cells": [
    {
      "id": "38a1cb5a",
      "cell_type": "code",
      "source": [
        "# Поиск интерпретатора Python с torch\ncands = String[]\nfor d in (\"/user/.user_venvs\",)\n    isdir(d) && for v in readdir(d); push!(cands, joinpath(d, v, \"bin\", \"python3\")); end\nend\nappend!(cands, [\"/usr/bin/python3\", \"/usr/local/bin/python3\", \"/opt/conda/bin/python3\", something(Sys.which(\"python3\"), \"\"), something(Sys.which(\"python\"), \"\")])\nfor py in unique(filter(isfile, cands))\n    r = read(ignorestatus(`$py -c \"import sys, importlib.util as u; print(sys.version.split()[0], 'torch' if u.find_spec('torch') else 'no-torch', sys.prefix)\"`), String)\n    println(py, \" => \", strip(r))\nend\nfor d in (\"/usr/local/share/jupyter/kernels\", \"/usr/share/jupyter/kernels\", joinpath(homedir(), \".local/share/jupyter/kernels\"), \"/opt/conda/share/jupyter/kernels\")\n    isdir(d) || continue\n    for k in readdir(d)\n        f = joinpath(d, k, \"kernel.json\"); isfile(f) && println(f, \": \", read(f, String))\n    end\nend\nprintln(\"ENV PYTHON: \", get(ENV, \"PYTHON\", \"-\"), \"; HOME: \", homedir())"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
