    {
      "id": "e0145fda",
      "cell_type": "code",
      "source": [
        "# Демонстрационный скрипт указаний как есть (вариант 1), в отдельной папке demo — его comparison.png не затрёт лист варианта\nmkpath(joinpath(W, \"demo\"))\ncmd_demo = addenv(Cmd(`$PY -u $(joinpath(W, \"lab08_demo.py\"))`; dir = joinpath(W, \"demo\")), \"OMP_NUM_THREADS\" => \"4\")\nt0 = time(); run(pipeline(cmd_demo; stdin = devnull, stdout = joinpath(W, \"demo\", \"out_demo.txt\"), stderr = joinpath(W, \"demo\", \"err_demo.txt\")))\nprintln(\"демонстрационный скрипт выполнен за \", round((time() - t0) / 60; digits = 1), \" мин; stderr: \", filesize(joinpath(W, \"demo\", \"err_demo.txt\")), \" байт\")"
      ],
      "execution_count": 0,
      "outputs": [],
