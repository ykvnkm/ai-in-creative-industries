    {
      "id": "c91d76a0",
      "cell_type": "code",
      "source": [
        "# Шаг 3–8. Скрипт варианта 2 (3 потока). Запуск блокирующий: фоновый запуск из ячейки (wait = false) в Engee\n# подвешивает ячейку. Если results_v02.json уже записан, скрипт повторно не запускается (обучение на процессоре\n# не побитово воспроизводимо, и повтор заменил бы уже сохранённые результаты другими).\ncmd_v2 = addenv(Cmd(`$PY -u $(joinpath(W, \"lr08_variant2.py\"))`; dir = W), \"OMP_NUM_THREADS\" => \"3\")\nif isfile(joinpath(W, \"results_v02.json\"))\n    println(\"результат варианта 2 уже есть: results_v02.json от \", Dates.unix2datetime(mtime(joinpath(W, \"results_v02.json\"))), \" UTC — повторно не запускаю\")\nelse\n    t0 = time(); run(pipeline(cmd_v2; stdin = devnull, stdout = joinpath(W, \"out_v02.txt\"), stderr = joinpath(W, \"err_v02.txt\")))\n    println(\"вариант 2 выполнен за \", round((time() - t0) / 60; digits = 1), \" мин\")\nend"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "результат варианта 2 уже есть: results_v02.json от 2026-10-27T15:38:34.242 UTC — повторно не запускаю\n"
        }
      ],
      "metadata": {
