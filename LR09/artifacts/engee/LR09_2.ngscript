  "cells": [
    {
      "id": "ddd99392",
      "cell_type": "code",
      "source": [
        "# Шаг 3 плана. Среда: дата, версии, файлы работы и их SHA-256; пакеты указаний\nusing Dates, SHA\nW = \"/user/Яковенко_Максим_Михайлович/LR09\"\nPY = \"/user/.user_venvs/py3.11/bin/python3\"\nprintln(\"Дата и время (UTC): \", now(UTC))\nprintln(\"Julia VERSION = \", VERSION, \";  ядер: \", Sys.CPU_THREADS, \";  ОЗУ: \", round(Sys.total_memory() / 2^30; digits = 1), \" ГБ\")\nfor (f, ref) in ((\"lab09_lib.py\", \"cc4d233d\"), (\"lab09_llm.py\", \"5eabb31f\"), (\"run_lr09.py\", \"a962a37b\"), (\"lr09_variant2.py\", \"\"))\n    h = bytes2hex(open(sha256, joinpath(W, f)))\n    println(rpad(f, 18), filesize(joinpath(W, f)), \" байт, SHA-256 \", h, isempty(ref) ? \"\" : \"; совпадает с архивом работы: $(startswith(h, ref))\")\nend\n# Раздел 4 указаний: diffusers 0.32.2 и transformers < 5, PyTorch не обновлять. Если torch в окружении нет\n# (так было в ЛР 8), ставится версия указаний — 2.4.1 для процессора. Вывод pip — в pip_install.log.\nhas(m) = success(ignorestatus(`$PY -c \"import $m\"`))\nPIPLOG = joinpath(W, \"pip_install.log\")\npipi(args...) = run(pipeline(`$PY -m pip install --progress-bar off $args`; stdin = devnull, stdout = PIPLOG, stderr = PIPLOG, append = true))\nhas(\"torch\") || (println(\"ставлю torch 2.4.1 (CPU)\"); pipi(\"torch==2.4.1\", \"--index-url\", \"https://download.pytorch.org/whl/cpu\"))\nhas(\"scipy\") || (println(\"ставлю scipy\"); pipi(\"scipy\"))\nver = read(ignorestatus(`$PY -c \"import diffusers, transformers; print(diffusers.__version__, transformers.__version__)\"`), String)\n# Команда указаний (\"transformers<5\") не обновляет уже стоящую версию 4.x (в окружении была 4.48.3), поэтому\n# ставится проверенная указаниями 4.57.6.\nstartswith(ver, \"0.32.2 4.57.\") || (println(\"ставлю diffusers==0.32.2, transformers==4.57.6\"); pipi(\"diffusers==0.32.2\", \"transformers==4.57.6\"))\nrun(`$PY -c \"import sys, torch, diffusers, transformers, scipy, numpy; print('python', sys.version.split()[0], '| torch', torch.__version__, '| diffusers', diffusers.__version__, '| transformers', transformers.__version__, '| scipy', scipy.__version__, '| numpy', numpy.__version__, '| cuda', torch.cuda.is_available())\"`)"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "8435074e",
      "cell_type": "code",
      "source": [
        "# Шаги 4–6 плана. Вариант 2: серия A и B на seed 101…105, сводка, проверки. Запуск блокирующий\n# (фоновый запуск из ячейки подвешивает ячейку). Если results_v02.json уже есть, повторно не запускается.\ncmd = Cmd(`$PY -u $(joinpath(W, \"lr09_variant2.py\"))`; dir = W)\nif isfile(joinpath(W, \"results_v02.json\"))\n    println(\"результат уже есть: results_v02.json от \", Dates.unix2datetime(mtime(joinpath(W, \"results_v02.json\"))), \" UTC — повторно не запускаю\")\nelse\n    t0 = time(); run(pipeline(cmd; stdin = devnull, stdout = joinpath(W, \"out_v02.txt\"), stderr = joinpath(W, \"err_v02.txt\")))\n    println(\"вариант 2 выполнен за \", round((time() - t0) / 60; digits = 1), \" мин; stderr: \", filesize(joinpath(W, \"err_v02.txt\")), \" байт\")\nend"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "98124027",
      "cell_type": "code",
      "source": [
        "# Вывод скрипта варианта целиком\nprint(read(joinpath(W, \"out_v02.txt\"), String))"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "da21e354",
      "cell_type": "code",
      "source": [
        "# Шаг 5 плана. Лист сравнения seed 101: слева A, справа B\nusing Images\nhcat(load(joinpath(W, \"v02\", \"A_s101.png\")), load(joinpath(W, \"v02\", \"B_s101.png\")))"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "615535f4",
      "cell_type": "code",
      "source": [
        "# Шаг 7 плана. Запросы части 2 для новых чатов языковой модели (контекст 1)\nfor a in (\"zero\", \"few\", \"step\")\n    println(\"=== \", a, \" ===\")\n    run(Cmd(`$PY $(joinpath(W, \"lab09_llm.py\")) prompt $a 1`; dir = W))\nend"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    }
  ]
}