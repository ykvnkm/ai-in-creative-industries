  "cells": [
    {
      "id": "diagpip1",
      "cell_type": "code",
      "source": [
        "# Диагностика установки transformers в окружение py3.11\nPY = \"/user/.user_venvs/py3.11/bin/python3\"\nprintln(read(ignorestatus(`$PY -c \"import transformers, sys; print(transformers.__file__); print(sys.prefix); print(sys.path)\"`), String))\nout = IOBuffer()\np = run(pipeline(ignorestatus(`$PY -m pip install --progress-bar off \"diffusers==0.32.2\" \"transformers<5\"`); stdout = out, stderr = out))\nprintln(\"exit: \", p.exitcode)\nprintln(String(take!(out)))\nprintln(read(ignorestatus(`$PY -c \"import transformers; print(transformers.__version__, transformers.__file__)\"`), String))"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    }
  ]
}