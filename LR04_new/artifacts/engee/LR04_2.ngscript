    {
      "id": "2212a81b",
      "cell_type": "code",
      "source": [
        "# Проверка 3. Соседние сцены с той же операцией и окно 5 × 5 на той же сцене (демо)\nfor n in (2, 8, 14, 1)\n    R = variant_summary4(n)\n    d = R.rows[1][5]\n    println(\"вариант \", rpad(string(n), 3), \"сцена \", R.ctx, \" (σₙ = \", scene4(R.ctx).noise, \"), операция \", R.fac,\n            \": PSNR \", round(R.rows[1][2]; digits = 3), \" → \", round(R.rows[1][4]; digits = 3), \", Δ = \", round(d; digits = 3),\n            \" дБ, |Δ|/s = \", round(R.rows[1][6]; digits = 1), \" → \", cls(d, TOL),\n            \";  энергия границ \", round(R.rows[2][2]; digits = 5), \" → \", round(R.rows[2][4]; digits = 5))\nend"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "вариант 2  сцена 1 (σₙ = 0.02), операция 2: PSNR 33.982 → 31.589, Δ = -2.393 дБ, |Δ|/s = 32.1 → вредна;  энергия границ 0.01693 → 0.00982\nвариант 8  сцена 2 (σₙ = 0.05), операция 2: PSNR 26.025 → 30.57, Δ = 4.545 дБ, |Δ|/s = 61.5 → полезна;  энергия границ 0.03278 → 0.01497\nвариант 14 сцена 3 (σₙ = 0.1), операция 2: PSNR 20.121 → 28.202, Δ = 8.081 дБ, |Δ|/s = 130.8 → полезна;  энергия границ 0.05868 → 0.02356\nвариант 1  сцена 1 (σₙ = 0.02), операция 1: PSNR 33.982 → 29.196, Δ = -4.786 дБ, |Δ|/s = 64.2 → вредна;  энергия границ 0.01693 → 0.00842\n"
        }
      ],
