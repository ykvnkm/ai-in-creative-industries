    {
      "id": "de337d2e",
      "cell_type": "code",
      "source": [
        "# Проверка 5. Намеренная ошибка раздела 6.4: сравнение с зашумлённым изображением вместо эталона\nwrong = [psnr_db(gauss4(make_gray4(s; P...), 1), make_gray4(s; P...)) for s in 101:105]\nprintln(\"PSNR(результат, зашумлённое) по seed: \", round.(wrong; digits = 3), \";  среднее \", round(sum(wrong) / 5; digits = 3), \" дБ\")\nprintln(\"PSNR(результат, эталон)     по seed: \", round.(ps_after; digits = 3), \";  среднее \", round(sum(ps_after) / 5; digits = 3), \" дБ\")\nprintln(\"первое число измеряет, насколько фильтр изменил картинку, а не её качество\")"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
