    {
      "id": "3b89b424",
      "cell_type": "code",
      "source": [
        "# Шаг 3. Зашумлённая и чистая сцены по параметрам варианта\nVARIANT = 2\nSCENE, OP = divrem(VARIANT - 1, 6) .+ 1\nP = scene4(SCENE)\nclean = clean4(SCENE)\nx101 = make_gray4(101; P...)\nprintln(\"вариант \", VARIANT, \": сцена \", SCENE, \", операция \", OP, \" (фильтр Гаусса, σ = 1)\")\nprintln(\"параметры сцены: \", P)\nprintln(\"зашумлённая: \", size(x101), \" \", eltype(x101), \", диапазон \", extrema(x101))\nprintln(\"эталон:      \", size(clean), \" \", eltype(clean), \", диапазон \", extrema(clean))\nprintln(\"SHA-256 зашумлённой, seed 101: \", array_sha(x101))\nprintln(\"SHA-256 повторного построения: \", array_sha(make_gray4(101; P...)), \"  совпадение: \", array_sha(x101) == array_sha(make_gray4(101; P...)))\nprintln(\"SHA-256 эталона:               \", array_sha(clean))\nprintln(\"доля значений, обрезанных до 0 или 1: \", count(v -> v == 0 || v == 1, x101) / length(x101))"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "вариант 2: сцена 1, операция 2 (фильтр Гаусса, σ = 1)\nпараметры сцены: (noise = 0.02, checker = 0, disc = 0.75, bg = (0.1, 0.4))\nзашумлённая: (128, 128) Float64, диапазон (0.06550155753085868, 0.8197951804301282)\nэталон:      (128, 128) Float64, диапазон (0.10234375000000001, 0.75)\nSHA-256 зашумлённой, seed 101: e7ecd4f73ea684ab746fc444eef55f0c18943d7fdcfc4fe7866b3f4b6012accf\nSHA-256 повторного построения: e7ecd4f73ea684ab746fc444eef55f0c18943d7fdcfc4fe7866b3f4b6012accf  совпадение: true\nSHA-256 эталона:               ab6367770d640f8ecc0002eef3d33db48d233ac3cdef6dfbbf375371b82ee73a\nдоля значений, обрезанных до 0 или 1: 0.0\n"
        }
      ],
