    {
      "id": "b676a0dd",
      "cell_type": "code",
      "source": [
        "# Шаг 6. Сводка варианта по серии seed: база, s, после, Δ, |Δ|/s\nS = variant_summary4(VARIANT)\nprintln(\"вариант \", S.variant, \": сцена \", S.ctx, \", операция \", S.fac, \";  IoU: \", S.iou, \" (для операции 2 не применяется)\")\nfor (m, b, s, a, dd, r, sig) in S.rows\n    println(rpad(string(m), 9), \"база = \", b, \"  s = \", s, \"  после = \", a, \"  Δ = \", dd,\n            \"  |Δ|/s = \", round(r; digits = 2), \"  |Δ|>2s = \", sig, \"  отн. = \", round(100 * dd / b; digits = 2), \" %\")\nend\nps_after = [psnr_db(gauss4(make_gray4(s; P...), 1), clean) for s in 101:105]\nprintln(\"PSNR после по seed 101…105: \", round.(ps_after; digits = 4))\nprintln(\"ΔPSNR по seed: \", round.(ps_after .- ps_noisy; digits = 4))"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "вариант 2: сцена 1, операция 2;  IoU: NaN (для операции 2 не применяется)\npsnr     база = 33.982103137714965  s = 0.07450305641014086  после = 31.5887137620817  Δ = -2.393389375633266  |Δ|/s = 32.12  |Δ|>2s = true  отн. = -7.04 %\nedge     база = 0.01692548814288977  s = 0.00012750148456890567  после = 0.009823456794529431  Δ = -0.007102031348360337  |Δ|/s = 55.7  |Δ|>2s = true  отн. = -41.96 %\ncontrast база = 0.20774642267754806  s = 0.00017156629178605263  после = 0.20277799042951364  Δ = -0.004968432248034421  |Δ|/s = 28.96  |Δ|>2s = true  отн. = -2.39 %\nPSNR после по seed 101…105: [31.6015, 31.5652, 31.5841, 31.6115, 31.5813]\nΔPSNR по seed: [-2.3227, -2.3553, -2.3975, -2.4932, -2.3983]\n"
