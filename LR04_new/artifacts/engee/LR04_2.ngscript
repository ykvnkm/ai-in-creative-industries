  "cells": [
    {
      "id": "00d78721",
      "cell_type": "code",
      "source": [
        "# Шаг 1. Подготовка среды: дата, версии, рабочая папка, учебные библиотеки\nusing Dates, SHA\nW = \"/user/Яковенко_Максим_Михайлович/LR04\"\nprintln(\"Дата и время (UTC): \", now(UTC))\nprintln(\"VERSION = \", VERSION, \";  потоков Julia: \", Threads.nthreads())\nprintln(\"Рабочая папка: \", W)\nlibsha(f) = bytes2hex(open(sha256, joinpath(W, f)))\nfor (f, ref) in ((\"lab03_lib.jl\", \"cd1622643e7cfe7c\"), (\"lab04_lib.jl\", \"094cecea2f55a0f5\"))\n    println(f, \": \", filesize(joinpath(W, f)), \" байт, SHA-256 = \", libsha(f),\n            \";  совпадает с указаниями (\", ref, \"…): \", startswith(libsha(f), ref))\nend\ninclude(joinpath(W, \"lab04_lib.jl\"))\nprintln(\"Images \", pkgversion(Images))\nmake_gray4(101) |> size"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Дата и время (UTC): 2026-10-27T14:37:44.736\nVERSION = 1.12.6;  потоков Julia: 5\nРабочая папка: /user/Яковенко_Максим_Михайлович/LR04\nlab03_lib.jl: 5027 байт, SHA-256 = cd1622643e7cfe7cc01bb7d8067e4802a76f6a76e9a6833ba4c09c84bb9fa62a;  совпадает с указаниями (cd1622643e7cfe7c…): true\nlab04_lib.jl: 4612 байт, SHA-256 = 094cecea2f55a0f53a652149a1a4025e98d87b3994b376be7028c4920cb0f8c2;  совпадает с указаниями (094cecea2f55a0f5…): true\nImages 0.26.2\n"
        },
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "(128, 128)"
          },
          "metadata": {},
          "execution_count": 1
        }
      ],
      "metadata": {
