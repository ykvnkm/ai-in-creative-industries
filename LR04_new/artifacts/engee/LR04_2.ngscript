    {
      "id": "30994f0a",
      "cell_type": "code",
      "source": [
        "# Проверка 1. Разложение ошибки: цена размытия эталона и остаток шума\nblur_cost = mse(gauss4(clean, 1), clean)\nprintln(\"MSE(gauss(эталон), эталон) — цена размытия: \", blur_cost, \"  (PSNR \", 10 * log10(1 / blur_cost), \" дБ)\")\nnratio = [let x = make_gray4(s; P...); n0 = x .- clean; var(gauss4(x, 1) .- gauss4(clean, 1)) / var(n0) end for s in 101:105]\nprintln(\"отношение дисперсии шума после фильтра к дисперсии до, по seed: \", round.(nratio; digits = 4))\nmse_noisy = [mse(make_gray4(s; P...), clean) for s in 101:105]\nmse_after = [mse(gauss4(make_gray4(s; P...), 1), clean) for s in 101:105]\nprintln(\"MSE до:    \", sum(mse_noisy) / 5)\nprintln(\"MSE после: \", sum(mse_after) / 5, \"  = цена размытия \", blur_cost, \" + остаток \", sum(mse_after) / 5 - blur_cost)"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "MSE(gauss(эталон), эталон) — цена размытия: 0.0006591472283027176  (PSNR 31.810175697792932 дБ)\nотношение дисперсии шума после фильтра к дисперсии до, по seed: [0.0855, 0.091, 0.087, 0.0864, 0.0888]\nMSE до:    0.00039979794676500604\nMSE после: 0.0006936360285351668  = цена размытия 0.0006591472283027176 + остаток 3.448880023244926e-5\n"
        }
      ],
      "metadata": {
        "name": " ",
