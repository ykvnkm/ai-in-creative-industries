    {
      "id": "cb1d3e18",
      "cell_type": "code",
      "source": [
        "# Проверка 4. Воспроизведение демонстрационного варианта 1 и сверка с указаниями бит в бит\nD = variant_summary4(1)\nDEMO = (psnr = (33.982103137714965, 0.07450305641014086, 29.19575338868147, -4.786349749033494),\n        edge = (0.01692548814288977, 0.00012750148456890567, 0.008424262473284544, -0.008501225669605225),\n        contrast = (0.20774642267754806, 0.00017156629178605263, 0.20065402164009138, -0.007092401037456675))\nDEMO_EXACT = true\nfor (m, b, s, a, dd, r, sig) in D.rows\n    ref = DEMO[m]\n    ok = (b, s, a, dd) == ref\n    global DEMO_EXACT &= ok\n    println(rpad(string(m), 9), \"база \", b, \"  s \", s, \"  после \", a, \"  Δ \", dd, \"  совпало бит в бит: \", ok)\nend\nprintln(\"демо воспроизведено бит в бит: \", DEMO_EXACT)"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "psnr     база 33.982103137714965  s 0.07450305641014086  после 29.19575338868147  Δ -4.786349749033494  совпало бит в бит: true\nedge     база 0.01692548814288977  s 0.00012750148456890567  после 0.008424262473284544  Δ -0.008501225669605225  совпало бит в бит: true\ncontrast база 0.20774642267754806  s 0.00017156629178605263  после 0.20065402164009138  Δ -0.007092401037456675  совпало бит в бит: true\nдемо воспроизведено бит в бит: true\n"
        }
      ],
