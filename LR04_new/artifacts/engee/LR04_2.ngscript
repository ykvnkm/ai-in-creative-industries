    {
      "id": "e6af6697",
      "cell_type": "code",
      "source": [
        "# Шаг 4. PSNR зашумлённой сцены относительно эталона и оценка −20·lg σₙ\nps_noisy = [psnr_db(make_gray4(s; P...), clean) for s in 101:105]\nprintln(\"PSNR зашумлённой по seed 101…105: \", round.(ps_noisy; digits = 4))\nprintln(\"среднее = \", sum(ps_noisy) / 5, \" дБ;  оценка −20·lg(\", P.noise, \") = \", -20 * log10(P.noise), \" дБ\")\nprintln(\"расхождение = \", sum(ps_noisy) / 5 - (-20 * log10(P.noise)), \" дБ\")"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "PSNR зашумлённой по seed 101…105: [33.9242, 33.9205, 33.9816, 34.1047, 33.9796]\nсреднее = 33.982103137714965 дБ;  оценка −20·lg(0.02) = 33.979400086720375 дБ\nрасхождение = 0.002703050994590228 дБ\n"
        }
      ],
      "metadata": {
        "name": " ",
        "engee": {
          "isDisplay": true,
