  "cells": [
    {
      "id": "6a96edda",
      "cell_type": "code",
      "source": [
        "# Шаг 3 плана. Среда: дата, версии, файлы работы и их SHA-256; пакеты указаний\nusing Dates, SHA\nW = \"/user/Яковенко_Максим_Михайлович/LR10\"\nPY = \"/user/.user_venvs/py3.11/bin/python3\"\nprintln(\"Дата и время (UTC): \", now(UTC))\nprintln(\"Julia VERSION = \", VERSION, \";  ядер: \", Sys.CPU_THREADS, \";  ОЗУ: \", round(Sys.total_memory() / 2^30; digits = 1), \" ГБ\")\n# lab10_lib.py перенесён из приложения А указаний (архив работы не выдан); SHA-256 — моей копии\nfor (f, ref) in ((\"lab10_lib.py\", \"b53293eb\"), (\"lr10_variant2.py\", \"\"))\n    h = bytes2hex(open(sha256, joinpath(W, f)))\n    println(rpad(f, 18), filesize(joinpath(W, f)), \" байт, SHA-256 \", h, isempty(ref) ? \"\" : \"; совпадает с копией в репозитории: $(startswith(h, ref))\")\nend\n# Раздел 4 указаний: diffusers 0.32.2 и transformers < 5, PyTorch не трогать (ставится только если его нет).\nhas(m) = success(ignorestatus(`$PY -c \"import $m\"`))\nPIPLOG = joinpath(W, \"pip_install.log\")\npipi(args...) = run(pipeline(`$PY -m pip install --progress-bar off $args`; stdin = devnull, stdout = PIPLOG, stderr = PIPLOG, append = true))\nhas(\"torch\") || (println(\"ставлю torch 2.4.1 (CPU)\"); pipi(\"torch==2.4.1\", \"--index-url\", \"https://download.pytorch.org/whl/cpu\"))\nhas(\"scipy\") || (println(\"ставлю scipy\"); pipi(\"scipy\"))\nver = read(ignorestatus(`$PY -c \"import diffusers, transformers; print(diffusers.__version__, transformers.__version__)\"`), String)\n# Команда указаний (\"transformers<5\") не обновляет уже стоящую версию 4.x (в окружении была 4.48.3), поэтому\n# ставится проверенная указаниями 4.57.6.\nstartswith(ver, \"0.32.2 4.57.\") || (println(\"ставлю diffusers==0.32.2, transformers==4.57.6\"); pipi(\"diffusers==0.32.2\", \"transformers==4.57.6\"))\nrun(`$PY -c \"import sys, torch, diffusers, transformers, scipy, numpy; print('python', sys.version.split()[0], '| torch', torch.__version__, '| diffusers', diffusers.__version__, '| transformers', transformers.__version__, '| scipy', scipy.__version__, '| numpy', numpy.__version__, '| cuda', torch.cuda.is_available())\"`)"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "03e85b7c",
      "cell_type": "code",
      "source": [
        "# Шаг 4 плана. variant_summary(2, save_dir=\"v02\") и blind_sheets(2, \"v02\"). Запуск блокирующий\n# (фоновый запуск из ячейки подвешивает ячейку). Если results_v02.json уже есть, повторно не запускается.\ncmd = Cmd(`$PY -u $(joinpath(W, \"lr10_variant2.py\"))`; dir = W)\nif isfile(joinpath(W, \"results_v02.json\"))\n    println(\"результат уже есть: results_v02.json от \", Dates.unix2datetime(mtime(joinpath(W, \"results_v02.json\"))), \" UTC — повторно не запускаю\")\nelse\n    t0 = time(); run(pipeline(cmd; stdin = devnull, stdout = joinpath(W, \"out_v02.txt\"), stderr = joinpath(W, \"err_v02.txt\")))\n    println(\"вариант 2 выполнен за \", round((time() - t0) / 60; digits = 1), \" мин; stderr: \", filesize(joinpath(W, \"err_v02.txt\")), \" байт\")\nend"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "9d1a55f2",
      "cell_type": "code",
      "source": [
        "# Вывод скрипта варианта целиком (ключ слепого сравнения в нём не печатается)\nprint(read(joinpath(W, \"out_v02.txt\"), String))"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "e096d977",
      "cell_type": "code",
      "source": [
        "# Шаг 5 плана. Пять листов слепого сравнения (seed 101…105 сверху вниз), без подписей моделей\nusing Images\nvcat((load(joinpath(W, \"v02\", \"blind_$s.png\")) for s in 101:105)...)"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    }
  ]
}