    {
      "id": "02431aaa",
      "cell_type": "code",
      "source": [
        "# Шаг 4. Яркость двумя способами и максимум модуля разности\ny_manual = luma_manual(img)\ny_gray = luma_images(img)\nprintln(\"максимум модуля разности = \", maximum(abs.(y_manual .- y_gray)))\nprintln(\"сравнение с допуском isapprox: \", isapprox(y_manual, y_gray))\nprintln(\"SHA вручную: \", array_sha(y_manual)[1:16])\nprintln(\"SHA Gray:    \", array_sha(y_gray)[1:16])\nprintln(\"контрольные суммы равны: \", array_sha(y_manual) == array_sha(y_gray))"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "максимум модуля разности = 9.856187532797378e-9\nсравнение с допуском isapprox: true\nSHA вручную: f9da0b1fb58661aa\nSHA Gray:    50567c6b9e5e4ac1\nконтрольные суммы равны: false\n"
        }
      ],
      "metadata": {
        "name": "Название секции",
        "engee": {
          "isDisplay": true,
