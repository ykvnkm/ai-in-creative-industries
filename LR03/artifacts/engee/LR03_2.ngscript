    {
      "id": "1c863843",
      "cell_type": "code",
      "source": [
        "# Шаг 3. Сцена варианта и её свойства: размер, тип, диапазон, объём в байтах\nVARIANT = 2\nSCENE, FACTOR = divrem(VARIANT - 1, 6) .+ 1\nP = scene_preset(SCENE)\nimg = make_scene(101; P...)\nd = describe_image(img)\nprintln(\"вариант \", VARIANT, \": сцена \", SCENE, \", воздействие \", FACTOR)\nprintln(\"параметры сцены: \", P)\nprintln(\"size = \", d.size, \", eltype = \", d.eltype)\nprintln(\"min = \", d.min, \", max = \", d.max)\nprintln(\"bytes = \", d.bytes, \"  (ожидалось 128·128·3·8 = \", 128 * 128 * 3 * 8, \")\")"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "вариант 2: сцена 1, воздействие 2\nпараметры сцены: (lo = 0.15, hi = 0.85, noise = 0.02, checker = 0)\nsize = (128, 128), eltype = RGB{Float64}\nmin = 0.08115622264322489, max = 0.9185814096363565\nbytes = 393216  (ожидалось 128·128·3·8 = 393216)\n"
        }
      ],
      "metadata": {
        "name": "Название секции",
        "engee": {
          "isDisplay": true,
