  "cells": [
    {
      "id": "6560f7cb",
      "cell_type": "code",
      "source": [
        "# Шаг 1. Подготовка среды: дата, версия Julia, рабочая папка, учебная библиотека\nusing Dates, SHA\nprintln(\"Дата и время (UTC): \", now(UTC))\nprintln(\"VERSION = \", VERSION)\ncd(\"/user/Яковенко_Максим_Михайлович/LR03\")\nprintln(\"Рабочая папка: \", pwd())\nlib = \"lab03_lib.jl\"\nprintln(\"lab03_lib.jl: \", filesize(lib), \" байт, SHA-256 = \", bytes2hex(open(sha256, lib)))\nprintln(\"совпадает с методичкой (cd1622643e7cfe7c…): \", startswith(bytes2hex(open(sha256, lib)), \"cd1622643e7cfe7c\"))\ninclude(lib)\nmake_scene(101) |> describe_image"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Дата и время (UTC): 2026-10-07T14:34:15.544\nVERSION = 1.12.4\nРабочая папка: /user/Яковенко_Максим_Михайлович/LR03\nlab03_lib.jl: 5027 байт, SHA-256 = cd1622643e7cfe7cc01bb7d8067e4802a76f6a76e9a6833ba4c09c84bb9fa62a\nсовпадает с методичкой (cd1622643e7cfe7c…): true\n"
        },
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "(size = (128, 128), eltype = \"RGB{Float64}\", min = 0.08115622264322489, max = 0.9185814096363565, bytes = 393216)"
          },
          "metadata": {},
          "execution_count": 1
        }
      ],
