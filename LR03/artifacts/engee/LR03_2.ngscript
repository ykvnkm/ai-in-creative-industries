    {
      "id": "48f8b232",
      "cell_type": "code",
      "source": [
        "# Шаг 5. Контрольная сумма яркости при seed 101 — дважды\nsha_1 = array_sha(luma_images(make_scene(101; P...)))\nsha_2 = array_sha(luma_images(make_scene(101; P...)))\nsha_ctrl = array_sha(luma_images(make_scene(102; P...)))\nprintln(\"seed 101, построение 1: \", sha_1)\nprintln(\"seed 101, построение 2: \", sha_2)\nprintln(\"совпадение: \", sha_1 == sha_2)\nprintln(\"контроль, seed 102:     \", sha_ctrl[1:16], \"  (отличается: \", sha_ctrl != sha_1, \")\")"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "seed 101, построение 1: 50567c6b9e5e4ac1b068d288afc484e1918714e92d7ec350c63efb1d20bfcfc6\nseed 101, построение 2: 50567c6b9e5e4ac1b068d288afc484e1918714e92d7ec350c63efb1d20bfcfc6\nсовпадение: true\nконтроль, seed 102:     ee2448c98b85ccef  (отличается: true)\n"
        }
      ],
      "metadata": {
        "name": "Название секции",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
